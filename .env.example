# Server-only contact form settings. Add the real values in Vercel.
RESEND_API_KEY=re_your_api_key
CONTACT_TO_EMAIL=your_private_destination_email
CONTACT_FROM_EMAIL=Portfolio Contact <contact@your_verified_domain.com>

# Google Maps browser key. This value is visible in browser code by design,
# so restrict it to localhost and your Vercel domains in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=your_restricted_browser_key

# Server-only key used by the Weather and Geocoding APIs. Never prefix this
# variable with NEXT_PUBLIC and never commit its real value.
GOOGLE_MAPS_SERVER_KEY=your_restricted_server_key
